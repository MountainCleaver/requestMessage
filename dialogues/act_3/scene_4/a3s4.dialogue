~ picture_frame
do player_danilo.force_cannot_move = true
Danilo: ...
- Take Image
	do Hud.add_popup_image("res://assets/tilesets/frame_blurred_only.png")
	do Hud._toggle_popup()
	Danilo: Bakit nagka ganito 'to?
	do Hud._toggle_popup()
	Danilo: ...
	- Flip image
		do Hud.add_popup_image("res://assets/tilesets/frame_behind.png")
		do Hud._toggle_popup()
		Danilo: [center][wave]Find [wait=1.0]me...[/wave][/center]
		Danilo: Anong ibig sabihin nito?
		Danilo: ... ...
		Danilo: Something's off...
		do Hud._toggle_popup()
		Danilo: ...
		- Take piece of paper
			do Hud.add_popup_image("res://assets/HUD/map.png")
			do Hud._toggle_popup()
			Danilo: Huh? 
			Danilo: [shake]Anong ginagawa ng mapang ‘to dito? [/shake]
			Danilo: [shake]Hindi ko maalala kung kailan ko ‘to huling nakita…[/shake]
			do Hud._toggle_popup()
			do inspected_picture_frame = true
			do SignalBus.fade_to_blackness.emit()
			do can_interact = true
=> END

