~ reminisce
Danilo: We used to play here...
Danilo: This place... still the same, yet... what is that [i]'thing'[/i]?
# pan camera to the shadow figure
do _tween_camera_to_ghost()
=> END

~ woke_up
Danilo: ???
Danilo: What... was that?
Danilo: What kind of dream was that?
- Take medications => take_medications
- Check phone for messages => check_phone
=> END

~ take_medications
do _get_out_of_bed_take_meds()
=> END

~ check_phone
do Hud.phone_intro()
do _get_out_of_bed_check_phone()
=> END

~ chat_of_wendy
do ChatManager.send_chat("wendy", "Wendy", "Danilo, have you heard that?")
Wendy: Danilo, have you heard that?

do ChatManager.send_chat("wendy", "Wendy", "Ang lakas ng kulog dito.")
Wendy: [wait=1.5]The thunder is so loud here.
- In the city too? => reply_danilo_1
- I thought it was just here... => reply_danilo_1
=> END

~ reply_danilo_1
do ChatManager.send_chat("wendy", "Player", "Diyan rin pala sa city. Akala ko dito lang sa province.")
Danilo: Same in the city. I thought it was only here in the province.
=> reply_wendy_1

~ reply_wendy_1
do ChatManager.send_chat("wendy", "Wendy", "Seems like anytime soon, baka umulan. Ingat ka, Dan.")
Wendy: [wait=1.5]Seems like it might rain anytime soon. Be careful, Dan.
- You too, Wen. => reply_danilo_2
=> END

~ reply_danilo_2
do ChatManager.send_chat("wendy", "Player", "Ikaw rin, Wen.")
Danilo: You too, Wen.
do Hud.phone_outro()
do _notice_open_window()
=> END

~ window_is_open
Danilo: [shake rate=20 level=10]!!![/shake]
Danilo: I closed all the windows earlier... why is this one open?
Danilo: Who... opened it?
do can_interact = true
=> END

~ gino_knock
do ObjectiveManager.update_progress(1, 1)
Danilo: [center][color=#808080]*(knock knock knock)*[/color][/center]
Danilo: [center]Doesn’t seem like anyone’s home...[/center]
do gino_knocked = true
do can_interact = true
do _check_objectives()
do SignalBus.asked_a_neighbor.emit()
=> END

~ gino_knock_again
Danilo: [center]No one here.[/center]
do can_interact = true
=> END

~ theresa
do ObjectiveManager.update_progress(1, 1)
Danilo: Good day, [wave]Aling Theresa.[/wave]
Aling_Theresa: Oh Danilo! You’re home.
Aling_Theresa: Just a short visit?
Danilo: Yes, I won’t stay long.
Danilo: Did you see anyone coming to the house earlier?
Aling_Theresa: [wave]Nope[/wave], I was busy cooking.
Danilo: Ah, I see. Thank you.
do SignalBus.remove_npc.emit("npc_theresa_scene_4")
do theresa_asked = true
do player_danilo.force_cannot_move = false
do _check_objectives()
do can_interact = true
do SignalBus.asked_a_neighbor.emit()
=> END

~ theresa_again
Aling_Theresa: Take care always.
do can_interact = true
=> END

~ vanesa
do ObjectiveManager.update_progress(1, 1)
Danilo: Good day, Vanesa.
Danilo: Did you see anyone going to the house earlier?
Vanesa: [wave]Nope.[/wave]
Vanesa: I’ve been here, didn’t see anything.
Vanesa: But yesterday, I saw you rushing home.
Danilo: Was anyone following me then?
Vanesa: [wave]Yes, [/wave][wait=1.5][wave]Jonathan.[/wave]
Vanesa: I was surprised by how fast you got home.
Danilo: I see... thanks.
do vanesa_asked = true
do can_interact = true
do _check_objectives()
do SignalBus.asked_a_neighbor.emit()
=> END

~ vanesa_again
Vanesa: ...
do can_interact = true
=> END

