~ condition_worsened
# reading diary
Danilo: Mateo... Diyos ko... lahat pala  'to tinago mo samin...
# chapel darken, soundfx
Danilo: Akala ko... Masaya ka... na wala kang dinadala...
Danilo: Pero pinabayaan kita.
Danilo: Mateo... Sorry...
# ghost appears
do _candle_dim()
do ghost_appears.emit("restless")
=> END

~ resltess_ghost_appeared
Entity: ...Danilo...bakit... iniwan mo ako...
Danilo: Mateo... Ikaw ba 'yan?
do show_distortion()
#=> END
#
#~ restless_ghost_turn_and_walk_a_bit
do mateo_turn("restless")
Entity: Halika... dito tayo... Danilo... dito...
do _candle_dimmer()
do mateo_walk_down("restless")
=> END

~ restless_cliff
# transition outside/cliff
# shadow stand near edge of cliff
Danilo: Mateo... 
Entity: ...
# look down
do _ghost_down("restless")
Entity: ...
Danilo: saglit lang... 
Entity: ...
# look left
do _ghost_left("restless")
Danilo: wag mo muna ako iwan...
Entity: [fade]...[/fade]
do _ghost_vanish("restless")
Danilo: nooooooooooooooooo
# shadow fades to nothing
# Danilo collapsed at the edge. The voices screamed louder, swallowing him in darkness.
=> END