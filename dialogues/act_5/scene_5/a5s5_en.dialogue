~ mang_gino_being_a_bitch
Mang gino: [font_size=55.0][shake level=20 connected=0]YOU LITTLE BRAT! THINK YOU CAN JUST RUN AWAY LIKE THAT, HUH?![/shake]
do _hit_mateo("idle_right")
Mateo_child_crying: [shake level=20 connected=0]Stop it, please [i]‘tay[/i]!! [/shake] [font_size=60.0][shake level=20 connected=0]Please, stop! I don’t want this anymore![/shake]
do _hit_mateo("idle_down")
Mang gino: [font_size=55.0][shake level=20 connected=0]So this is where you’ve been hiding, huh?[/shake]
do _hit_mateo("idle_right")
Mang gino: [font_size=55.0][shake level=20 connected=0]Look at all these clothes you’ve piled up![/shake]
do _spawn_gino_mateo_stuff()
Mang gino: [font_size=55.0][shake level=20 connected=0]What now? You’re leaving me?[/shake]
do _gino_thrashing_stuff()
Mang gino: [font_size=70.0][shake level=20 connected=0]THEN GO! LEAVE! YOU’RE USELESS ANYWAY![/shake]
Mateo_child_crying: [shake level=20 connected=0]Please, stop, [i]‘tay[/i]! I’ll go home! [/shake] [font_size=55.0][shake]Please don’t break my things![/shake]
do _gino_respawn()
Mang gino: [font_size=70.0][shake level=20 connected=0]YOUR THINGS? WORTHLESS. YOU DON'T A OWN A SINGLE THING!![/shake]
do _hit_mateo("idle_right")
Mang gino: [font_size=55.0][shake level=20 connected=0]Everything you have, you stole it from the house![/shake]
Mang gino: [font_size=55.0][shake level=20 connected=0]You really think me and your mother would even bother looking for you?[/shake]
do _hit_mateo("idle_right")
Mang gino: [font_size=120.0][shake level=20 connected=0]NO![/shake]
Mang gino: [font_size=70.0][shake level=20 connected=0]YOU’RE ON YOUR OWN![/shake]
do _hit_mateo("idle_right")
Mang gino: [font_size=90.0][shake level=20 connected=0]YOU WERE NEVER NEEDED HERE![/shake]
do is_hit = true
=>< mateo_monologue
=> END

~ mateo_monologue
Mateo_child_crying: [center][shake]I can’t take it anymore... I can’t...[/shake][/center]
Mateo_child_crying: [center][shake]Why does it always have to be me?[/shake][/center]
