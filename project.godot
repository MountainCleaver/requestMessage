; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="RequestMessage"
run/main_scene="uid://h36f1ipl8glj"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://deo8gfi46k6og"

[autoload]

GameSceneManager="*res://helpers/game_scene_manager.gd"
Settings="*res://globals/settings.gd"
SignalBus="*res://globals/signal_bus.gd"
Profile="*res://globals/profile.gd"
SaveManager="*res://globals/save_manager.gd"
TransitionFade="*res://helpers/transition_fade.tscn"
WhiteTransitionFade="*res://helpers/white_transition_fade.tscn"
Hud="*res://globals/hud.tscn"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
ObjectiveManager="*res://globals/objective_manager.gd"
AnimationManager="*res://globals/animation_manager.gd"
BgmManager="*res://globals/bgm_manager.gd"
Global="*res://globals/Global.gd"
ChatManager="*res://globals/chat_manager.gd"
NarrationPanel="*res://helpers/narration_panel.gd"
GameState="*res://globals/game_state.gd"
Session="*res://globals/session_manager.gd"

[dialogue_manager]

runtime/balloon_path="res://dialogues/balloon.tscn"

[display]

window/size/viewport_width=1440
window/size/viewport_height=1024
window/size/mode=3
window/stretch/mode="canvas_items"
window/main_scene="uid://bro8lnbrtlvoc"
window/minimum_display_time=8000
window/image="uid://h36f1ipl8glj"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

