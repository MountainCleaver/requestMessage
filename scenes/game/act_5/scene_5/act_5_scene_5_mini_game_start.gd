extends Node2D

func _on_area_2d_input_event(_viewport: Node, event: InputEvent, _shape_idx: int) -> void:
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:
		if SignalBus.has_signal("next_scene"):
			SignalBus.next_scene.emit("res://scenes/game/act_5/scene_5/act_5_scene_5_mini_game.tscn")
		else:
			push_warning("SignalBus missing 'next_scene' signal")
